# Copy to .env for local development. All values shown are the built-in defaults.

# On Render, point this at the mounted disk, e.g. sqlite:////var/data/typeform.db
DATABASE_URL=sqlite:///./typeform.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used to build the shareable public link returned as form.public_url.
# In production set this to the deployed frontend, e.g. https://your-app.vercel.app/f
PUBLIC_FORM_BASE_URL=http://localhost:3000/f

# The stand-in logged-in creator (authentication is out of scope).
DEFAULT_CREATOR_EMAIL=creator@typeformclone.dev
DEFAULT_CREATOR_NAME=Alex Morgan
